namespace porsche {U render_thrash_exports_006bd910[43]{};}
static void install(){
    auto* slots=porsche::render_thrash_exports_006bd910;
    slots[29]=word(reinterpret_cast<const void*>(&get));slots[27]=word(reinterpret_cast<const void*>(&set));
