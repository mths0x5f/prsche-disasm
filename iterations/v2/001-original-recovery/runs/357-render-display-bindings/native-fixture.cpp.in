            block[i][p++]=static_cast<unsigned char>(arities[i]*4);
        }
        std::memcpy(block[i]+p,original[i],6);
        U target=helper[i]?word(&helper_proc_cell):word(&slots[slot_index[i]]);
        std::memcpy(block[i]+p+2,&target,4);p+=6;
        if(helper[i])block[i][p++]=0xc3;
        else {block[i][p++]=0xc2;block[i][p++]=static_cast<unsigned char>(arities[i]*4);block[i][p++]=0;}
    }
    FlushInstructionCache(GetCurrentProcess(),code,0x1000);
}
struct Capture{U esp0,esp1,ebp0,ebp1,ebx0,ebx1,esi0,esi1,edi0,edi1,eax;};
static Capture invoke(const void* fn,U argc,const U* a,bool cdecl_call){
    Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,6a31c5e7h
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        mov ecx,argc
        mov edx,a
        cmp ecx,5
        jb push4
        push dword ptr [edx+16]
    push4:
        cmp ecx,4
        jb push3
        push dword ptr [edx+12]
    push3:
        cmp ecx,3
        jb push2
        push dword ptr [edx+8]
    push2:
        cmp ecx,2
        jb push1
        push dword ptr [edx+4]
    push1:
        cmp ecx,1
        jb callit
        push dword ptr [edx]
    callit:
        mov ecx,fn
        call ecx
        lea edx,r
        mov [edx+40],eax
        cmp cdecl_call,0
        je captured
        mov ecx,argc
        shl ecx,2
        add esp,ecx
    captured:
        lea edx,r
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }
    return r;
}
static bool abi(const Capture& r){return r.esp0==r.esp1&&r.ebp0==r.ebp1&&r.ebx0==r.ebx1&&
    r.esi0==r.esi1&&r.edi0==r.edi1&&r.ebx0==0x13579bdfu&&r.esi0==0x2468ace0u&&r.edi0==0x6a31c5e7u;}
struct State{U count;Event log[16];};
static void reset(){event_count=0;std::memset(events,0,sizeof(events));}
static State state(){State s{};s.count=event_count;std::memcpy(s.log,events,sizeof(events));return s;}
static const void* native[11]={
    reinterpret_cast<const void*>(&porsche::render_display_getstate_006bd984),
    reinterpret_cast<const void*>(&porsche::render_display_setstate_006bd97c),
    reinterpret_cast<const void*>(&porsche::render_display_window_006bd9b0),
    reinterpret_cast<const void*>(&porsche::render_display_set_texture_006bd954),
    reinterpret_cast<const void*>(&porsche::render_display_clear_window_006bd91c),
    reinterpret_cast<const void*>(&porsche::render_display_draw_quad_006bd9a8),
    reinterpret_cast<const void*>(&porsche::render_display_flush_006bd970),
    reinterpret_cast<const void*>(&porsche::render_display_sync_006bd978),
    reinterpret_cast<const void*>(&porsche::render_display_read_rect_006bd96c),
    reinterpret_cast<const void*>(&porsche::render_loader_set_state_006bd97c),
    reinterpret_cast<const void*>(&porsche::render_loader_about_006bd934)};
static bool compare(U i,const U* in){
    U a[5]{};std::memcpy(a,in,arities[i]*4);
    if(i==9)helper_proc_cell=a[0]=word(reinterpret_cast<const void*>(&helper_set));
    if(i==10)helper_proc_cell=a[0]=word(reinterpret_cast<const void*>(&about));
    reset();Capture x=invoke(block[i],arities[i],a,helper[i]);State expected=state();
    reset();Capture y=invoke(native[i],arities[i],a,helper[i]);State actual=state();++cases;
    if(!abi(x)||!abi(y)||std::memcmp(&expected,&actual,sizeof(State))||
        (result_used[i]&&x.eax!=y.eax)){
        std::printf("divergence render-display-%u case=%u abi=%u/%u events=%u/%u eax=%08x/%08x\n",
            i,cases,abi(x),abi(y),expected.count,actual.count,x.eax,y.eax);return false;}
    return true;
}
int main(){
    install();bool ok=true;
    const U zero[5]{};const U get_args[5]={0x1d};const U set_args[5]={0x0a,2};
    const U window_args[5]={2};const U texture_args[5]={0};
    const U quad_args[5]={0x11223344,0x55667788,0x99aabbcc,0xddeeff00};
    const U rect_args[5]={0,0,0x80,1,0x76543210};
