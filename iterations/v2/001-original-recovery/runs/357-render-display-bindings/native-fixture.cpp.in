    slots[3]=word(reinterpret_cast<const void*>(&clear));slots[38]=word(reinterpret_cast<const void*>(&quad));
    slots[24]=word(reinterpret_cast<const void*>(&flush));slots[26]=word(reinterpret_cast<const void*>(&sync));
    slots[23]=word(reinterpret_cast<const void*>(&rect));
