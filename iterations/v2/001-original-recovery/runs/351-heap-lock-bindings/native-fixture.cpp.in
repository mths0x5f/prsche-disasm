#include "porsche/application_heap.hpp"
#include "porsche/heap.hpp"
#include "porsche/heap_locks.hpp"
#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <initializer_list>

using U=std::uint32_t;
static_assert(sizeof(void*)==4);
static const unsigned char original_enter[12]={@ENTER@};
static const unsigned char original_leave[12]={@LEAVE@};
static unsigned char* code;
static unsigned char* body[2];
static U cases=0,count=0,iat_enter=0,iat_leave=0;
struct Event{U kind,pointer;};
static Event events[16]{};
static U word(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void fail(const char* why){std::printf("fixture %s\n",why);ExitProcess(98);}
static void record(U kind,void* pointer){if(count>=16)fail("event-overflow");events[count++]={kind,word(pointer)};}
extern "C" void __stdcall native_enter(void* pointer){record(1,pointer);}
extern "C" void __stdcall native_leave(void* pointer){record(2,pointer);}
namespace porsche {
void __stdcall platform_enter_critical_section(void* pointer){native_enter(pointer);}
void __stdcall platform_leave_critical_section(void* pointer){native_leave(pointer);}
// Link-only boundaries from other heap_locks.cpp functions; this proof never calls them.
void __stdcall platform_initialize_critical_section(void*){fail("unexpected-initialize");}
void __stdcall platform_delete_critical_section(void*){fail("unexpected-delete");}
void __cdecl heap_fill_0053c290(void*,U,U){fail("unexpected-fill");}
void* __cdecl file_object_allocate_0056e5f0(U*){fail("unexpected-allocate");return nullptr;}
void __cdecl thread_init_0055f320(U){fail("unexpected-thread-init");}
U threads_initialized_006a57dc=1;
}
static void patch_abs(U function,U old,U replacement){
    U patches=0;
    for(U i=0;i+4<=12;++i){U observed;std::memcpy(&observed,body[function]+i,4);
        if(observed==old){std::memcpy(body[function]+i,&replacement,4);++patches;i+=3;}}
    if(patches!=1)fail("absolute-patch-count");
}
static void install(){
    code=static_cast<unsigned char*>(VirtualAlloc(nullptr,0x1000,MEM_COMMIT|MEM_RESERVE,PAGE_EXECUTE_READWRITE));
    if(!code)fail("alloc");
    body[0]=code;body[1]=code+0x100;
    std::memcpy(body[0],original_enter,12);std::memcpy(body[1],original_leave,12);
    if(body[0][5]!=0xff||body[0][6]!=0x15||body[1][5]!=0xff||body[1][6]!=0x15)fail("indirect-call-opcode");
    iat_enter=word(reinterpret_cast<const void*>(&native_enter));
    iat_leave=word(reinterpret_cast<const void*>(&native_leave));
    patch_abs(0,0x5b2078,word(&iat_enter));
    patch_abs(1,0x5b206c,word(&iat_leave));
    FlushInstructionCache(GetCurrentProcess(),code,0x200);
}
struct Capture{U esp0,esp1,ebp0,ebp1,ebx0,ebx1,esi0,esi1,edi0,edi1;};
static Capture invoke(const void* function,void* pointer){
    Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,6a31c5e7h
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        push pointer
        mov ecx,function
        call ecx
        add esp,4
        lea edx,r
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }
    return r;
}
static bool abi(const Capture& r){return r.esp0==r.esp1&&r.ebp0==r.ebp1&&r.ebx0==r.ebx1&&r.esi0==r.esi1&&r.edi0==r.edi1&&r.ebx0==0x13579bdfu&&r.esi0==0x2468ace0u&&r.edi0==0x6a31c5e7u;}
struct State{U count;Event events[16];};
static void reset(){count=0;std::memset(events,0,sizeof(events));}
static State state(){State s{};s.count=count;std::memcpy(s.events,events,sizeof(events));return s;}
static bool compare(const char* label,U which,void* pointer){
    reset();Capture x=invoke(body[which],pointer);State expected=state();
    reset();const void* adapters[2]={reinterpret_cast<const void*>(&porsche::application_lock_enter),reinterpret_cast<const void*>(&porsche::application_lock_leave)};
    Capture y=invoke(adapters[which],pointer);State actual=state();++cases;
    if(!abi(x)||!abi(y)||std::memcmp(&expected,&actual,sizeof(State))){
        std::printf("divergence %s case=%u abi=%u/%u events=%u/%u\n",label,cases,abi(x),abi(y),expected.count,actual.count);return false;}
    return true;
}
static bool sequence(void* first,void* second){
    auto execute=[&](bool original){
        reset();
        invoke(original?body[0]:reinterpret_cast<const void*>(&porsche::application_lock_enter),first);
        invoke(original?body[0]:reinterpret_cast<const void*>(&porsche::application_lock_enter),second);
        invoke(original?body[1]:reinterpret_cast<const void*>(&porsche::application_lock_leave),second);
        invoke(original?body[1]:reinterpret_cast<const void*>(&porsche::application_lock_leave),first);
        return state();
    };
    State expected=execute(true),actual=execute(false);++cases;
    if(std::memcmp(&expected,&actual,sizeof(State))){std::printf("divergence ordered-lock-sequence case=%u\n",cases);return false;}
    return true;
}
int main(){
    install();bool ok=true;U cells[2]={0x12345678u,0x87654321u};
    for(void* pointer:{static_cast<void*>(nullptr),static_cast<void*>(&cells[0]),static_cast<void*>(&cells[1]),reinterpret_cast<void*>(0x80000000u)}){
        ok&=compare("enter-pointer",0,pointer);
        ok&=compare("leave-pointer",1,pointer);
    }
    ok&=sequence(&cells[0],&cells[1]);
    std::printf("heap_lock_bindings_original_vs_cpp=%s cases=%u\n",ok?"PASS":"FAIL",cases);
    return ok?0:1;
}
