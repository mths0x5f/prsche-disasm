struct Capture{U sp0,sp1,bp0,bp1,bx0,bx1,si0,si1,di0,di1,eax;};
static Capture invoke(const void* fn,U argc,const U* args){Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,6a31c5e7h
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        mov ecx,argc
        mov edx,args
        cmp ecx,5
        jb four
        push dword ptr [edx+16]
    four:
        cmp ecx,4
        jb three
        push dword ptr [edx+12]
    three:
        cmp ecx,3
        jb two
        push dword ptr [edx+8]
    two:
        cmp ecx,2
        jb one
        push dword ptr [edx+4]
    one:
        cmp ecx,1
        jb callit
        push dword ptr [edx]
    callit:
        mov ecx,fn
        call ecx
        lea edx,r
        mov [edx+40],eax
        mov ecx,argc
        shl ecx,2
        add esp,ecx
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }return r;
}

