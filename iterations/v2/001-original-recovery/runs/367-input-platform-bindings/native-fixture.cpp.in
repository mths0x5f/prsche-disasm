#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include "../361-startup-device-pool/startup_device.hpp"
#include "porsche/startup_input.hpp"
#include "porsche/window_create.hpp"
using U=std::uint32_t;
static_assert(sizeof(void*)==4);
// SHA-pinned original instructions. All forwarding pushes/RET are fixture code.
static const unsigned char original[5][6]={{@DINPUT@},{@KEYBOARD@},
    {@CURSOR@},{@SCREEN@},{@MODULE@}};
static const U lengths[5]={6,5,6,6,6},arity[5]={4,4,1,2,0};
static const U targets[5]={0x5b202c,0x56e940,0x5b2280,0x5b228c,0x5b2138};
static unsigned char* code;static unsigned char* block[5];
static U cells[4]{},event_count=0,cases=0,result=0,write_mode=0;
static DWORD *import_cells[2]{};static DWORD old_imports[2]{};
static porsche::StartupPoint point;static void* output;
struct Event{U kind,a,b,c,d;};static Event events[8]{};
static U word(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void die(const char* s){std::printf("fixture %s\n",s);std::fflush(stdout);ExitProcess(98);}
static void rec(U kind,U a=0,U b=0,U c=0,U d=0){
    if(event_count>=8)die("events");events[event_count++]={kind,a,b,c,d};
}
extern "C" std::int32_t __stdcall stub_directinput(void* instance,U version,void** out,void* outer){
    rec(0,word(instance),version,word(out),word(outer));
    if(out&&write_mode)*out=reinterpret_cast<void*>(0x85abcdefu);
    return static_cast<std::int32_t>(result);
}
// Fixture-only storage satisfies the real source import-cell alias, without
// linking a substitute DINPUT DLL or changing the production declaration.
extern "C" {std::int32_t (__stdcall *_imp__DirectInputCreateA)(void*,U,void**,void*)=&stub_directinput;}
static void write_point(POINT* p){if(!p)return;
    if(write_mode)p->x=static_cast<LONG>(0x87654321u);
    if(write_mode==2)p->y=0x12345678;
}
extern "C" BOOL __stdcall stub_cursor(POINT* p){rec(1,word(p));write_point(p);return static_cast<BOOL>(result);}
extern "C" BOOL __stdcall stub_screen(HWND h,POINT* p){rec(2,word(h),word(p));write_point(p);return static_cast<BOOL>(result);}
namespace porsche {void* __stdcall window_module_handle(const char* name){
    rec(3,word(name));return reinterpret_cast<void*>(result);
}}
static void patch_imports(){
    auto* base=reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
    auto* dos=reinterpret_cast<IMAGE_DOS_HEADER*>(base);
    auto* nt=reinterpret_cast<IMAGE_NT_HEADERS32*>(base+dos->e_lfanew);
    if(dos->e_magic!=IMAGE_DOS_SIGNATURE||nt->Signature!=IMAGE_NT_SIGNATURE)die("pe");
    auto* desc=reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base+nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT].VirtualAddress);
    const char* names[2]={"GetCursorPos","ScreenToClient"};bool seen[2]{};
    for(;desc->Name;++desc){
        if(_stricmp(reinterpret_cast<const char*>(base+desc->Name),"USER32.dll"))continue;
        if(!desc->OriginalFirstThunk)die("original-thunks");
        auto* name=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->OriginalFirstThunk);
        auto* iat=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->FirstThunk);
        for(;name->u1.AddressOfData;++name,++iat){
            if(IMAGE_SNAP_BY_ORDINAL32(name->u1.Ordinal))continue;
            auto* item=reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base+name->u1.AddressOfData);
            for(U i=0;i<2;++i)if(std::strcmp(reinterpret_cast<const char*>(item->Name),names[i])==0){
                DWORD old,ignored;import_cells[i]=&iat->u1.Function;old_imports[i]=iat->u1.Function;
                if(!VirtualProtect(import_cells[i],4,PAGE_READWRITE,&old))die("protect");
                *import_cells[i]=cells[i+1];
                if(!VirtualProtect(import_cells[i],4,old,&ignored))die("protect-mode");seen[i]=true;
            }
        }
    }
    if(!seen[0]||!seen[1])die("missing-import");
}
static void restore_imports(){for(U i=0;i<2;++i){DWORD old,ignored;
    if(!VirtualProtect(import_cells[i],4,PAGE_READWRITE,&old))die("restore-protect");
    *import_cells[i]=old_imports[i];
    if(!VirtualProtect(import_cells[i],4,old,&ignored))die("restore-mode");
}}
static void install(){
    cells[0]=word(reinterpret_cast<const void*>(&stub_directinput));
    cells[1]=word(reinterpret_cast<const void*>(&stub_cursor));
    cells[2]=word(reinterpret_cast<const void*>(&stub_screen));
    cells[3]=word(reinterpret_cast<const void*>(&porsche::window_module_handle));
    code=static_cast<unsigned char*>(VirtualAlloc(nullptr,0x1000,MEM_RESERVE|MEM_COMMIT,PAGE_EXECUTE_READWRITE));
    if(!code)die("alloc");
    for(U i=0;i<5;++i){block[i]=code+i*0x80;U n=0;
        if(i==0){
            if(original[i][0]!=0xff||original[i][1]!=0x25)die("thunk-opcode");
        }else if(i==4){block[i][n++]=0x6a;block[i][n++]=0;}
        else for(U a=0;a<arity[i];++a){
            block[i][n++]=0xff;block[i][n++]=0x74;block[i][n++]=0x24;
            block[i][n++]=static_cast<unsigned char>(arity[i]*4);
        }
        std::memcpy(block[i]+n,original[i],lengths[i]);U operand;
        if(i==1){
            if(original[i][0]!=0xe8)die("keyboard-call");
            std::int32_t rel;std::memcpy(&rel,original[i]+1,4);
            if(static_cast<U>(0x55fd50u+5+rel)!=targets[i])die("keyboard-target");
            rel=static_cast<std::int32_t>(word(block[0])-word(block[i]+n+5));
            std::memcpy(block[i]+n+1,&rel,4);
        }else{
            std::memcpy(&operand,original[i]+2,4);if(operand!=targets[i])die("iat-target");
            const U c=i==0?0:i-1;operand=word(&cells[c]);
            std::memcpy(block[i]+n+2,&operand,4);
        }
        n+=lengths[i];
        if(i!=0){block[i][n++]=0xc2;block[i][n++]=static_cast<unsigned char>(arity[i]*4);block[i][n++]=0;}
    }
    FlushInstructionCache(GetCurrentProcess(),code,0x1000);patch_imports();
}
struct Capture{U esp0,esp1,ebp0,ebp1,ebx0,ebx1,esi0,esi1,edi0,edi1,eax;};
static Capture invoke(const void* fn,U argc,const U* a){Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,6a31c5e7h
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        mov ecx,argc
        mov edx,a
        cmp ecx,4
        jb three
        push dword ptr [edx+12]
    three:
        cmp ecx,3
        jb two
        push dword ptr [edx+8]
    two:
        cmp ecx,2
        jb one
        push dword ptr [edx+4]
    one:
        cmp ecx,1
        jb callit
        push dword ptr [edx]
    callit:
        mov ecx,fn
        call ecx
        lea edx,r
        mov [edx+40],eax
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }
    return r;
}
static bool abi(const Capture& c){return c.esp0==c.esp1&&c.ebp0==c.ebp1&&c.ebx0==c.ebx1&&
    c.esi0==c.esi1&&c.edi0==c.edi1&&c.ebx0==0x13579bdfu&&c.esi0==0x2468ace0u&&c.edi0==0x6a31c5e7u;}
struct State{U count;Event log[8];porsche::StartupPoint point;void* output;};
static void reset(){event_count=0;std::memset(events,0,sizeof events);point={-12345,67890};output=reinterpret_cast<void*>(0xdeadbeefu);}
static State state(){State s{};s.count=event_count;std::memcpy(s.log,events,sizeof events);s.point=point;s.output=output;return s;}
static const void* native[5]={
    reinterpret_cast<const void*>(&porsche::startup_directinput_create_0056e940),
    reinterpret_cast<const void*>(&porsche::startup_input_direct_input_create),
    reinterpret_cast<const void*>(&porsche::startup_get_cursor_pos),
    reinterpret_cast<const void*>(&porsche::startup_screen_to_client),
    reinterpret_cast<const void*>(&porsche::startup_input_get_module_handle)};
static bool compare(U i,const U* args){
    reset();Capture x=invoke(block[i],arity[i],args);State expected=state();
    reset();Capture y=invoke(native[i],arity[i],args);State actual=state();++cases;
    if(!abi(x)||!abi(y)||x.eax!=y.eax||std::memcmp(&expected,&actual,sizeof actual)){
        std::printf("divergence input-platform kind=%u case=%u abi=%u/%u eax=%08x/%08x\n",i,cases,abi(x),abi(y),x.eax,y.eax);return false;
    }return true;
}
int main(){install();bool ok=true;const U values[]={0,1,0x80004005u,0xffffffffu};
    for(U r:values)for(U mode=0;mode<3;++mode){result=r;write_mode=mode;
        U direct[4]={0x87651234u,0x500,word(&output),0x12345678u};
        U other[4]={0,0xffffffffu,0,0};U cursor[4]={word(&point)};
        U screen[4]={0x9321abcd,word(&point)},nullpoint[4]={0,0},empty[4]={};
        ok&=compare(0,direct);ok&=compare(1,direct);ok&=compare(0,other);ok&=compare(1,other);
        ok&=compare(2,cursor);ok&=compare(2,nullpoint);ok&=compare(3,screen);ok&=compare(3,nullpoint);
        ok&=compare(4,empty);
    }
    restore_imports();
    std::printf("input_platform_original_imports_vs_cpp=%s cases=%u\n",ok?"PASS":"FAIL",cases);
    return ok?0:1;
}
