#include "porsche/game_setup.hpp"
#include "porsche/splash_progress.hpp"
#include "porsche/render_loader.hpp"
#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstring>

using U=std::uint32_t;
static_assert(sizeof(void*)==4);
// Each array is one original caller instruction block, not a function body.
static const unsigned char original[9][8]={
    {@GAME_WINDOW@},{@GAME_CLEAR@},{@GAME_FLUSH@},{@GAME_FLIP@},{@GAME_SYNC@},
    {@SPLASH_WINDOW@},{@SPLASH_CLEAR@},{@SPLASH_FLIP@},{@SPLASH_SYNC@}};
static const U lengths[9]={8,6,6,6,7,8,6,6,8};
static const U original_slots[9]={0x6bd9b0,0x6bd91c,0x6bd970,0x6bd948,0x6bd978,
                                    0x6bd9b0,0x6bd91c,0x6bd948,0x6bd978};
static const U slot_index[9]={40,3,24,14,26,40,3,14,26};
static const bool one_arg[9]={true,false,false,false,true,true,false,false,true};
static unsigned char* code;
static unsigned char* block[9];
static U cases=0,event_count=0;
struct Event{U slot,arg;};
static Event events[32]{};
static U word(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void die(const char* reason,U where=0){std::printf("fixture %s %08x\n",reason,where);ExitProcess(98);}
static void record(U slot,U arg){if(event_count>=32)die("events");events[event_count++]={slot,arg};}
extern "C" U __stdcall endpoint_window(U arg){record(40,arg);return 0xaabbcc40u;}
extern "C" U __stdcall endpoint_clear(){record(3,0);return 0xaabbcc03u;}
extern "C" U __stdcall endpoint_flush(){record(24,0);return 0xaabbcc18u;}
extern "C" U __stdcall endpoint_flip(){record(14,0);return 0xaabbcc0eu;}
extern "C" U __stdcall endpoint_sync(U arg){record(26,arg);return 0xaabbcc1au;}
namespace porsche {U render_thrash_exports_006bd910[43]{};}
static void install(){
    auto* slots=porsche::render_thrash_exports_006bd910;
    slots[40]=word(reinterpret_cast<const void*>(&endpoint_window));
    slots[3]=word(reinterpret_cast<const void*>(&endpoint_clear));
    slots[24]=word(reinterpret_cast<const void*>(&endpoint_flush));
    slots[14]=word(reinterpret_cast<const void*>(&endpoint_flip));
    slots[26]=word(reinterpret_cast<const void*>(&endpoint_sync));
    code=static_cast<unsigned char*>(VirtualAlloc(nullptr,0x1000,MEM_COMMIT|MEM_RESERVE,PAGE_EXECUTE_READWRITE));
    if(!code)die("alloc");
    for(U i=0;i<9;++i){
        block[i]=code+i*0x40;
        std::memcpy(block[i],original[i],lengths[i]);
        const U call_offset=lengths[i]-6;
        auto* call=block[i]+call_offset;
        if(call[0]!=0xff||call[1]!=0x15)die("call-opcode",i);
        U original_slot;std::memcpy(&original_slot,call+2,4);
        if(original_slot!=original_slots[i])die("call-slot",i);
        const U current_slot=word(&slots[slot_index[i]]);
        std::memcpy(call+2,&current_slot,4);
        if(one_arg[i]){
            block[i][lengths[i]]=0xc2;block[i][lengths[i]+1]=4;block[i][lengths[i]+2]=0;
        }else block[i][lengths[i]]=0xc3;
    }
    if(block[4][0]!=0x57)die("game-sync-push-edi");
    if(block[0][0]!=0x6a||block[0][1]!=2||block[5][0]!=0x6a||block[5][1]!=2)die("window-mode");
    if(block[8][0]!=0x6a||block[8][1]!=0)die("splash-sync-zero");
    FlushInstructionCache(GetCurrentProcess(),code,0x1000);
}
struct Capture{U esp0,esp1,ebp0,ebp1,ebx0,ebx1,esi0,esi1,edi0,edi1;};
static Capture invoke(const void* fn,U argument,bool takes_argument,U initial_edi){
    Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,initial_edi
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        cmp takes_argument,0
        je no_argument
        push argument
    no_argument:
        mov ecx,fn
        call ecx
        lea edx,r
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }
    return r;
}
static bool abi(const Capture& r,U expected_edi){
    return r.esp0==r.esp1&&r.ebp0==r.ebp1&&r.ebx0==r.ebx1&&r.esi0==r.esi1&&r.edi0==r.edi1&&
        r.ebx0==0x13579bdfu&&r.esi0==0x2468ace0u&&r.edi0==expected_edi;
}
struct State{U count;Event log[32];};
static void reset(){event_count=0;std::memset(events,0,sizeof(events));}
static State state(){State s{};s.count=event_count;std::memcpy(s.log,events,sizeof(events));return s;}
static const void* native[9]={
    reinterpret_cast<const void*>(&porsche::game_setup_render_begin_006bd9b0),
    reinterpret_cast<const void*>(&porsche::game_setup_render_reset_006bd91c),
    reinterpret_cast<const void*>(&porsche::game_setup_render_prepare_006bd970),
    reinterpret_cast<const void*>(&porsche::game_setup_render_update_006bd948),
    reinterpret_cast<const void*>(&porsche::game_setup_render_finish_006bd978),
    reinterpret_cast<const void*>(&porsche::splash_progress_thrash_window_006bd9b0),
    reinterpret_cast<const void*>(&porsche::splash_progress_thrash_clear_window_006bd91c),
    reinterpret_cast<const void*>(&porsche::splash_progress_thrash_pageflip_006bd948),
    reinterpret_cast<const void*>(&porsche::splash_progress_thrash_sync_006bd978)};
static bool compare(U which,U argument,U edi){
    reset();Capture x=invoke(block[which],argument,one_arg[which],edi);State expected=state();
    reset();Capture y=invoke(native[which],argument,one_arg[which],edi);State actual=state();++cases;
    if(!abi(x,edi)||!abi(y,edi)||std::memcmp(&expected,&actual,sizeof(State))){
        std::printf("divergence render-callsite-%u case=%u abi=%u/%u events=%u/%u\n",
            which,cases,abi(x,edi),abi(y,edi),expected.count,actual.count);return false;}
    return true;
}
static bool sequence(const U* order,U count){
    auto execute=[&](bool orig){
        reset();
        for(U k=0;k<count;++k){U i=order[k];U argument=(i==0||i==5)?2u:0u;
            U edi=i==4?0u:0x6a31c5e7u;
            Capture r=invoke(orig?block[i]:native[i],argument,one_arg[i],edi);
            if(!abi(r,edi))die("sequence-abi",i);}
        return state();
    };
    State expected=execute(true),actual=execute(false);++cases;
    if(std::memcmp(&expected,&actual,sizeof(State))){std::printf("divergence render-sequence case=%u\n",cases);return false;}
    return true;
}
int main(){
    install();bool ok=true;
    for(U i=0;i<9;++i)ok&=compare(i,(i==0||i==5)?2u:0u,i==4?0u:0x6a31c5e7u);
    const U game[5]={0,1,2,3,4},splash[4]={5,6,8,7};
    ok&=sequence(game,5);ok&=sequence(splash,4);
    std::printf("render_bindings_original_calls_vs_cpp=%s cases=%u\n",ok?"PASS":"FAIL",cases);
    return ok?0:1;
}
