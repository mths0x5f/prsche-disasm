static Event events[64];
static U event_count=0;
static U ptr(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void event(U type,U a=0,U b=0,U c=0){if(event_count>=64)ExitProcess(98);events[event_count++]={type,a,b,c};}
static void die(const char* why,U at=0){std::printf("fixture %s %08x\n",why,at);std::fflush(stdout);ExitProcess(98);}
