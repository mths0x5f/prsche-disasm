#include <windows.h>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <initializer_list>

using U=std::uint32_t;
static_assert(sizeof(void*)==4);
static const unsigned char pe_pool[251]={@POOL_BODY@};
static const unsigned char pe_name[9]={@POOL_NAME@};
static const unsigned char pe_too_many[53]={@POOL_TOO_MANY@};
static const unsigned char pe_error_file[19]={@POOL_FILE@};
static const unsigned char pe_already[33]={@POOL_ALREADY@};
static unsigned char* original;
alignas(16) static unsigned char arena[12288];
static const char alloc_name[]="ASYNCREQ";
static const char already[]="initasync - already initialized\n";
static const char too_many[]="initasync - too many async request blocks specified\n";
static U cases=0,checks=0;
struct Event{U type,a,b,c;};
static Event events[16];
static U event_count=0;
static U ptr(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void event(U type,U a=0,U b=0,U c=0){
    if(event_count>=16)ExitProcess(98);
    events[event_count++]={type,a,b,c};
}
static void die(const char* why,U value=0){std::printf("fixture %s %08x\n",why,value);std::fflush(stdout);ExitProcess(98);}
namespace porsche {
std::uint32_t shared_runtime_word_005deb74=0;
std::uint32_t shared_runtime_word_005deb78=0;
std::uint32_t& class_error_file_005deb74=shared_runtime_word_005deb74;
std::uint32_t& class_error_line_005deb78=shared_runtime_word_005deb78;
void (__cdecl* diagnostic_handler_005debf0)(const char*)=nullptr;
void* __cdecl allocate_00531ca0(const char* name,std::int32_t size,U flags){
    event(1,std::strcmp(name,alloc_name)==0,static_cast<U>(size),flags);
    return arena+128;
}
void* __cdecl heap_lock_create_005321f0(){event(2);return arena+12000;}
std::uint32_t __cdecl async_pool_callback_00563bd0(U,U){return 0;}
U __cdecl window_scheduler_register_005365e0(TimedCallback cb,U period,U delay){
    event(3,cb==async_pool_callback_00563bd0,period,delay);
    return 0x12345678u;
}
}
static void diagnostic(const char* message){
    event(4,std::strcmp(message,already)==0?1u:std::strcmp(message,too_many)==0?2u:0u,
        porsche::class_error_file_005deb74,porsche::class_error_line_005deb78);
}
static void patch_abs(U old,U replacement,U expected){
    U found=0;
    for(U i=0;i+4<=251;++i){U got=0;std::memcpy(&got,original+i,4);
        if(got==old){std::memcpy(original+i,&replacement,4);i+=3;++found;}}
    if(found!=expected)die("absolute-patch",old);
}
static void patch_call(U va,const void* target){
    const U at=va-0x563ad0u;
    if(original[at]!=0xe8)die("call-patch",va);
    const U displacement=ptr(target)-ptr(original+at+5);
    std::memcpy(original+at+1,&displacement,4);
}
static void install(){
    if(std::memcmp(pe_name,alloc_name,sizeof(pe_name))!=0)die("raw-name");
    if(std::memcmp(pe_too_many,too_many,sizeof(pe_too_many))!=0)die("raw-too-many");
    if(std::memcmp(pe_already,already,sizeof(pe_already))!=0)die("raw-already");
    if(std::memcmp(pe_error_file,"\\real\\cmn\\nasync.c",sizeof(pe_error_file))!=0)
        die("raw-error-file");
    original=static_cast<unsigned char*>(VirtualAlloc(nullptr,4096,MEM_COMMIT|MEM_RESERVE,PAGE_READWRITE));
    if(!original)die("alloc-code");
    std::memcpy(original,pe_pool,251);
    patch_abs(0x006a5bc0u,ptr(&porsche::async_pool_base_006a5bc0),3);
    patch_abs(0x006a5bc8u,ptr(&porsche::async_pool_head_006a5bc8),1);
    patch_abs(0x006a5bccu,ptr(&porsche::async_pool_tail_006a5bcc),1);
    patch_abs(0x006a5bd0u,ptr(&porsche::async_pool_first_006a5bd0),1);
    patch_abs(0x006a5bd4u,ptr(&porsche::async_pool_last_006a5bd4),1);
    patch_abs(0x006a5bd8u,ptr(&porsche::async_pool_priority_006a5bd8),1);
    patch_abs(0x006a5be0u,ptr(&porsche::async_pool_capacity_006a5be0),1);
    patch_abs(0x006a5be4u,ptr(&porsche::async_pool_active_006a5be4),1);
    patch_abs(0x006a5be8u,ptr(&porsche::async_pool_lock_006a5be8),1);
    patch_abs(0x005deb74u,ptr(&porsche::shared_runtime_word_005deb74),2);
    patch_abs(0x005deb78u,ptr(&porsche::shared_runtime_word_005deb78),2);
    patch_abs(0x005debf0u,ptr(&porsche::diagnostic_handler_005debf0),2);
    patch_abs(0x005bcfb4u,ptr(already),1);
    patch_abs(0x005bcf68u,ptr(too_many),1);
    patch_abs(0x005bcf5cu,ptr(alloc_name),1);
    patch_abs(0x00563bd0u,ptr(&porsche::async_pool_callback_00563bd0),1);
    patch_call(0x563b57u,reinterpret_cast<const void*>(&porsche::allocate_00531ca0));
    patch_call(0x563b84u,reinterpret_cast<const void*>(&porsche::heap_lock_create_005321f0));
    patch_call(0x563bbfu,reinterpret_cast<const void*>(&porsche::window_scheduler_register_005365e0));
    DWORD old=0;
    if(!VirtualProtect(original,4096,PAGE_EXECUTE_READ,&old))die("protect-code");
    FlushInstructionCache(GetCurrentProcess(),original,4096);
}
struct State{
    U globals[9],file,line,event_count;
    Event events[16];
    unsigned char arena[sizeof(::arena)];
};
static void reset(bool initialized){
    std::memset(arena,0xa5,sizeof(arena));
    porsche::async_pool_base_006a5bc0=initialized?arena+128:nullptr;
    porsche::async_pool_head_006a5bc8=0x11111111u;
    porsche::async_pool_tail_006a5bcc=0x22222222u;
    porsche::async_pool_first_006a5bd0=reinterpret_cast<void*>(0x33333333u);
    porsche::async_pool_last_006a5bd4=reinterpret_cast<void*>(0x44444444u);
    porsche::async_pool_priority_006a5bd8=0x55555555u;
    porsche::async_pool_capacity_006a5be0=0x66666666u;
    porsche::async_pool_active_006a5be4=0x77777777u;
    porsche::async_pool_lock_006a5be8=reinterpret_cast<void*>(0x88888888u);
    porsche::shared_runtime_word_005deb74=0x99999999u;
    porsche::shared_runtime_word_005deb78=0xaaaaaaaau;
    porsche::diagnostic_handler_005debf0=diagnostic;
    event_count=0;std::memset(events,0,sizeof(events));
}
static State snapshot(){
    State s{};
    s.globals[0]=ptr(porsche::async_pool_base_006a5bc0);
    s.globals[1]=porsche::async_pool_head_006a5bc8;
    s.globals[2]=porsche::async_pool_tail_006a5bcc;
    s.globals[3]=ptr(porsche::async_pool_first_006a5bd0);
    s.globals[4]=ptr(porsche::async_pool_last_006a5bd4);
    s.globals[5]=porsche::async_pool_priority_006a5bd8;
    s.globals[6]=porsche::async_pool_capacity_006a5be0;
    s.globals[7]=porsche::async_pool_active_006a5be4;
    s.globals[8]=ptr(porsche::async_pool_lock_006a5be8);
    s.file=porsche::shared_runtime_word_005deb74;
    s.line=porsche::shared_runtime_word_005deb78;
    s.event_count=event_count;
    std::memcpy(s.events,events,sizeof(events));
    std::memcpy(s.arena,arena,sizeof(arena));
    return s;
}
static void one(U count,U priority,U flags,bool initialized){
    using Fn=void (__cdecl*)(U,U,U);
    reset(initialized);
    reinterpret_cast<Fn>(original)(count,priority,flags);
    const State a=snapshot();
    reset(initialized);
    porsche::startup_subsystem_00563ad0(count,priority,flags);
    const State b=snapshot();
    const auto* x=reinterpret_cast<const unsigned char*>(&a);
    const auto* y=reinterpret_cast<const unsigned char*>(&b);
    for(U i=0;i<sizeof(State);++i){++checks;if(x[i]!=y[i]){
        std::printf("divergence state count=%08x priority=%08x flags=%08x initialized=%u byte=%u original=%02x cpp=%02x\n",count,priority,flags,initialized,i,x[i],y[i]);
        std::fflush(stdout);ExitProcess(1);}}
    ++cases;
}
int main(){
    // Compare the actual production definitions before reset() installs sentinels.
    const U initial_pool[9]={ptr(porsche::async_pool_base_006a5bc0),
        porsche::async_pool_head_006a5bc8,porsche::async_pool_tail_006a5bcc,
        ptr(porsche::async_pool_first_006a5bd0),ptr(porsche::async_pool_last_006a5bd4),
        porsche::async_pool_priority_006a5bd8,porsche::async_pool_capacity_006a5be0,
        porsche::async_pool_active_006a5be4,ptr(porsche::async_pool_lock_006a5be8)};
    for(U i=0;i<9;++i){++checks;if(initial_pool[i]!=0)die("initial-pool-BSS",i);}
    install();
    for(U count:{0u,1u,2u,30u,256u,257u,0xffffffffu,0x80000000u})
      for(U priority:{0u,0x2000u,0xffffffffu})
        for(U flags:{0u,7u})one(count,priority,flags,false);
    for(U count:{0u,30u,257u})one(count,0x2000u,0,true);
    std::printf("startup_pool_original_vs_cpp=PASS cases=%u checks=%u\n",cases,checks);
    return 0;
}
