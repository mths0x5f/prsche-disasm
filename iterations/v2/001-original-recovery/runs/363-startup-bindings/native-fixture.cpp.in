#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include "porsche/application_instance.hpp"
#include "porsche/startup_services.hpp"
#include "porsche/application_heap.hpp"
#include "porsche/formatter_text.hpp"
#include "porsche/file_threads.hpp"
#include "porsche/heap.hpp"
#include <cstdint>
#include <cstdio>
#include <cstring>

using U=std::uint32_t;
static_assert(sizeof(void*)==4);
// Original call instructions only; argument pushes and RET are fixture construction.
static const unsigned char original[6][6]={{@MUTEX@},{@ERROR@},{@FILENAME@},
    {@ALPHA@},{@THREAD@},{@LOCK@}};
static const U lengths[6]={6,6,6,5,5,5};
static const U targets[6]={0x5b21ac,0x5b213c,0x5b2064,0x5a2c24,0x55f320,0x5321f0};
static const U arity[6]={3,0,3,1,1,0};
static const bool facade_stdcall[6]={false,false,true,false,false,false};
static const bool result_used[6]={true,true,true,true,false,true};
static const char* import_names[3]={"CreateMutexA","GetLastError","GetModuleFileNameA"};
static U endpoint_cells[3]{},old_imports[3]{};
static DWORD* import_cells[3]{};
static unsigned char* code;
static unsigned char* block[6];
static U cases=0,event_count=0,last_error_value=0,thread_state=0,lock_count=0;
static char filename[32]{};
struct Event{U kind,a,b,c;};
static Event events[16]{};
static U word(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void die(const char* s,U n=0){std::printf("fixture %s %u\n",s,n);ExitProcess(98);}
static void rec(U kind,U a=0,U b=0,U c=0){if(event_count>=16)die("events");events[event_count++]={kind,a,b,c};}
extern "C" HANDLE __stdcall stub_mutex(SECURITY_ATTRIBUTES* security,BOOL owner,LPCSTR name){
    rec(0,word(security),static_cast<U>(owner),word(name));last_error_value=183;
    return reinterpret_cast<HANDLE>(0x23456789u);
}
extern "C" DWORD __stdcall stub_error(){rec(1,last_error_value);return last_error_value;}
extern "C" DWORD __stdcall stub_filename(HMODULE module,LPSTR output,DWORD capacity){
    rec(2,word(module),word(output),capacity);
    const char* value="C:\\PORSCHE.EXE";U n=static_cast<U>(std::strlen(value));
    if(n>capacity)n=capacity;
    if(n)std::memcpy(output,value,n);
    if(n<capacity)output[n]=0;
    last_error_value=0x421;
    return n;
}
namespace porsche {
void __cdecl formatter_fatal_005a2e22(int){die("unrelated-fatal");}
int __cdecl formatter_text_alpha_005a2c24(int c){rec(3,static_cast<U>(c));return c=='C'?0x103:0;}
void __cdecl thread_init_0055f320(U count){rec(4,count);thread_state=count+1;}
void* __cdecl heap_lock_create_005321f0(){rec(5,lock_count);++lock_count;return reinterpret_cast<void*>(0x3456789au);}
}
static const void* direct_targets[3]={
    reinterpret_cast<const void*>(&porsche::formatter_text_alpha_005a2c24),
    reinterpret_cast<const void*>(&porsche::thread_init_0055f320),
    reinterpret_cast<const void*>(&porsche::heap_lock_create_005321f0)};
static void pin_imports(){
    volatile auto a=&::CreateMutexA;volatile auto b=&::GetLastError;
    volatile auto c=&::GetModuleFileNameA;
    if(!a||!b||!c)die("import-pin");
}
static void patch_imports(){
    auto* base=reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
    auto* dos=reinterpret_cast<IMAGE_DOS_HEADER*>(base);
    if(dos->e_magic!=IMAGE_DOS_SIGNATURE)die("dos");
    auto* nt=reinterpret_cast<IMAGE_NT_HEADERS32*>(base+dos->e_lfanew);
    if(nt->Signature!=IMAGE_NT_SIGNATURE)die("pe");
    auto dir=nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
    if(!dir.VirtualAddress)die("imports");
    bool seen[3]{};
    auto* desc=reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base+dir.VirtualAddress);
    for(;desc->Name;++desc){
        auto* dll=reinterpret_cast<const char*>(base+desc->Name);
        if(_stricmp(dll,"KERNEL32.dll"))continue;
        if(!desc->OriginalFirstThunk)die("original-thunks");
        auto* names=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->OriginalFirstThunk);
        auto* iat=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->FirstThunk);
        for(;names->u1.AddressOfData;++names,++iat){
            if(IMAGE_SNAP_BY_ORDINAL32(names->u1.Ordinal))continue;
            auto* item=reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base+names->u1.AddressOfData);
            for(U i=0;i<3;++i)if(std::strcmp(reinterpret_cast<const char*>(item->Name),import_names[i])==0){
                DWORD old=0,ignored=0;
                if(!VirtualProtect(&iat->u1.Function,sizeof(U),PAGE_READWRITE,&old))die("protect",i);
                import_cells[i]=&iat->u1.Function;old_imports[i]=iat->u1.Function;
                iat->u1.Function=endpoint_cells[i];
                if(!VirtualProtect(&iat->u1.Function,sizeof(U),old,&ignored))die("protect-mode",i);
                seen[i]=true;
            }
        }
    }
    for(U i=0;i<3;++i)if(!seen[i])die("missing-import",i);
}
static void restore_imports(){
    for(U i=0;i<3;++i){DWORD old=0,ignored=0;
        if(!VirtualProtect(import_cells[i],sizeof(U),PAGE_READWRITE,&old))die("restore-protect",i);
        *import_cells[i]=old_imports[i];
        if(!VirtualProtect(import_cells[i],sizeof(U),old,&ignored))die("restore-mode",i);
    }
}
static void install(){
    pin_imports();
    endpoint_cells[0]=word(reinterpret_cast<const void*>(&stub_mutex));
    endpoint_cells[1]=word(reinterpret_cast<const void*>(&stub_error));
    endpoint_cells[2]=word(reinterpret_cast<const void*>(&stub_filename));
    code=static_cast<unsigned char*>(VirtualAlloc(nullptr,0x1000,MEM_COMMIT|MEM_RESERVE,PAGE_EXECUTE_READWRITE));
    if(!code)die("alloc");
    for(U i=0;i<6;++i){
        block[i]=code+i*0x40;U p=0;
        for(U n=0;n<arity[i];++n){block[i][p++]=0xff;block[i][p++]=0x74;
            block[i][p++]=0x24;block[i][p++]=static_cast<unsigned char>(arity[i]*4);}
        std::memcpy(block[i]+p,original[i],lengths[i]);
        if(i<3){
            if(original[i][0]!=0xff||original[i][1]!=0x15)die("iat-opcode",i);
            U operand;std::memcpy(&operand,original[i]+2,4);
            if(operand!=targets[i])die("iat-target",i);
            U address=word(&endpoint_cells[i]);std::memcpy(block[i]+p+2,&address,4);
        }else{
            if(original[i][0]!=0xe8)die("direct-opcode",i);
            std::int32_t rel;std::memcpy(&rel,original[i]+1,4);
            // The original E8 target is source VA + 5 + signed displacement.
            const U source_va=i==3?0x4a5c83u:(i==4?0x59e9d6u:0x59ea1au);
            if(static_cast<U>(source_va+5+rel)!=targets[i])die("direct-target",i);
            U next=word(block[i]+p+5),destination=word(direct_targets[i-3]);
            std::int32_t adjusted=static_cast<std::int32_t>(destination-next);
            std::memcpy(block[i]+p+1,&adjusted,4);
        }
        p+=lengths[i];
        if(i==3||i==4){block[i][p++]=0x83;block[i][p++]=0xc4;block[i][p++]=4;}
        if(facade_stdcall[i]){block[i][p++]=0xc2;block[i][p++]=static_cast<unsigned char>(arity[i]*4);block[i][p++]=0;}
        else block[i][p++]=0xc3;
    }
    FlushInstructionCache(GetCurrentProcess(),code,0x1000);
    patch_imports();
}
struct Capture{U esp0,esp1,ebp0,ebp1,ebx0,ebx1,esi0,esi1,edi0,edi1,eax;};
static Capture invoke(const void* fn,U argc,const U* a,bool stdcall_facade){
    Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,6a31c5e7h
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        mov ecx,argc
        mov edx,a
        cmp ecx,3
        jb two
        push dword ptr [edx+8]
    two:
        cmp ecx,2
        jb one
        push dword ptr [edx+4]
    one:
        cmp ecx,1
        jb callit
        push dword ptr [edx]
    callit:
        mov ecx,fn
        call ecx
        lea edx,r
        mov [edx+40],eax
        cmp stdcall_facade,0
        jne captured
        mov ecx,argc
        shl ecx,2
        add esp,ecx
    captured:
        lea edx,r
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }
    return r;
}
static bool abi(const Capture& r){return r.esp0==r.esp1&&r.ebp0==r.ebp1&&r.ebx0==r.ebx1&&
    r.esi0==r.esi1&&r.edi0==r.edi1&&r.ebx0==0x13579bdfu&&r.esi0==0x2468ace0u&&r.edi0==0x6a31c5e7u;}
struct State{U count;Event log[16];U error,thread,locks;char output[32];};
static void reset(){event_count=0;std::memset(events,0,sizeof(events));last_error_value=0x777;
    thread_state=0;lock_count=0;std::memset(filename,0xcc,sizeof(filename));}
static State state(){State s{};s.count=event_count;std::memcpy(s.log,events,sizeof(events));
    s.error=last_error_value;s.thread=thread_state;s.locks=lock_count;
    std::memcpy(s.output,filename,sizeof(filename));return s;}
static const void* native[6]={
    reinterpret_cast<const void*>(&porsche::application_instance_create_mutex),
    reinterpret_cast<const void*>(&porsche::application_instance_get_last_error),
    reinterpret_cast<const void*>(&porsche::startup_module_filename),
    reinterpret_cast<const void*>(&porsche::startup_drive_character_005a2c24),
    reinterpret_cast<const void*>(&porsche::application_os_start),
    reinterpret_cast<const void*>(&porsche::application_lock_create)};
static bool compare(U i,const U* a){
    reset();Capture x=invoke(block[i],arity[i],a,facade_stdcall[i]);State expected=state();
    reset();Capture y=invoke(native[i],arity[i],a,facade_stdcall[i]);State actual=state();++cases;
    if(!abi(x)||!abi(y)||std::memcmp(&expected,&actual,sizeof(State))||
        (result_used[i]&&x.eax!=y.eax)){
        std::printf("divergence startup-binding-%u case=%u abi=%u/%u events=%u/%u eax=%08x/%08x\n",
            i,cases,abi(x),abi(y),expected.count,actual.count,x.eax,y.eax);return false;}
    return true;
}
static bool mutex_error_sequence(const U* mutex_args){
    const U empty[3]{};
    auto run=[&](bool orig){reset();
        Capture a=invoke(orig?block[0]:native[0],3,mutex_args,false);
        Capture b=invoke(orig?block[1]:native[1],0,empty,false);
        if(!abi(a)||!abi(b))die("sequence-abi");
        struct Result{State state;U handle,error;};return Result{state(),a.eax,b.eax};
    };
    auto x=run(true),y=run(false);++cases;
    if(std::memcmp(&x,&y,sizeof x)){std::printf("divergence startup-mutex-error-order case=%u\n",cases);return false;}
    return true;
}
int main(){
    install();bool ok=true;
    static const char mutex_name[]="Porsche";
    const U mutex_args[3]={0,1,word(mutex_name)},empty[3]={},module_args[3]={0,word(filename),0xff};
    const U small_module[3]={0,word(filename),4},letter[3]={'C'},high[3]={0xffffffffu},thread[3]={0};
    ok&=compare(0,mutex_args);ok&=compare(1,empty);
    ok&=compare(2,module_args);ok&=compare(2,small_module);
    ok&=compare(3,letter);ok&=compare(3,high);
    ok&=compare(4,thread);ok&=compare(5,empty);
    ok&=mutex_error_sequence(mutex_args);
    restore_imports();
    std::printf("startup_bindings_original_calls_vs_cpp=%s cases=%u\n",ok?"PASS":"FAIL",cases);
    return ok?0:1;
}
