#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include "porsche/render_loader.hpp"
#include <cstdint>
#include <cstdio>
#include <cstring>

using U=std::uint32_t;
static_assert(sizeof(void*)==4);
// PE IAT-call instructions, plus the two original MOV ESI,[IAT] loads.
static const unsigned char original_call[6][6]={
    {@LOAD_CALL@},{@PROC_CALL@},{@FREE_CALL@},{@MODULE_CALL@},{@DISABLE_CALL@},{@ERROR_CALL@}};
static const unsigned char original_load[2][6]={{@LOAD_IAT@},{@PROC_IAT@}};
static const U call_length[6]={2,2,6,6,6,6};
static const U original_iat[6]={0x5b2050,0x5b205c,0x5b2088,0x5b2138,0x5b21b4,0x5b213c};
static const U arg_count[6]={1,2,1,1,1,0};
static const char* import_names[6]={"LoadLibraryA","GetProcAddress","FreeLibrary",
    "GetModuleHandleA","DisableThreadLibraryCalls","GetLastError"};
static unsigned char* code;
static unsigned char* block[6];
static U endpoints[6]{},cases=0,event_count=0,last_error_value=0;
static DWORD* import_cells[6]{};
static U original_endpoints[6]{};
struct Event{U kind,a,b;};
static Event events[16]{};
static U word(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static void die(const char* s,U n=0){std::printf("fixture %s %u\n",s,n);ExitProcess(98);}
namespace porsche {void __cdecl formatter_fatal_005a2e22(int){die("unrelated-fatal");}}
static void record(U kind,U a=0,U b=0){if(event_count>=16)die("events");events[event_count++]={kind,a,b};}
extern "C" HMODULE __stdcall stub_load(const char* name){
    record(0,word(name));last_error_value=0xace00123u;
    return name?reinterpret_cast<HMODULE>(0x23456789u):nullptr;
}
extern "C" FARPROC __stdcall stub_proc(HMODULE module,const char* name){
    record(1,word(module),word(name));return reinterpret_cast<FARPROC>(0x3456789au);
}
extern "C" BOOL __stdcall stub_free(HMODULE module){record(2,word(module));return 0;}
extern "C" HMODULE __stdcall stub_module(const char* name){record(3,word(name));return reinterpret_cast<HMODULE>(0x456789abu);}
extern "C" BOOL __stdcall stub_disable(HMODULE module){record(4,word(module));return 0;}
extern "C" DWORD __stdcall stub_error(){record(5,last_error_value);return last_error_value;}
static bool same(const char* a,const char* b){return std::strcmp(a,b)==0;}
static void pin_imports(){
    // Keep all six EXE IAT entries present even when a mutation removes one adapter call.
    volatile auto load=&::LoadLibraryA;volatile auto proc=&::GetProcAddress;
    volatile auto free_library=&::FreeLibrary;volatile auto module=&::GetModuleHandleA;
    volatile auto disable=&::DisableThreadLibraryCalls;volatile auto error=&::GetLastError;
    if(!load||!proc||!free_library||!module||!disable||!error)die("import-pin");
}
static void patch_imports(){
    auto* base=reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
    auto* dos=reinterpret_cast<IMAGE_DOS_HEADER*>(base);
    if(dos->e_magic!=IMAGE_DOS_SIGNATURE)die("dos");
    auto* nt=reinterpret_cast<IMAGE_NT_HEADERS32*>(base+dos->e_lfanew);
    if(nt->Signature!=IMAGE_NT_SIGNATURE)die("pe");
    auto dir=nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
    if(!dir.VirtualAddress)die("import-directory");
    bool seen[6]{};
    auto* desc=reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base+dir.VirtualAddress);
    for(;desc->Name;++desc){
        const char* dll=reinterpret_cast<const char*>(base+desc->Name);
        if(_stricmp(dll,"KERNEL32.dll"))continue;
        auto* names=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->OriginalFirstThunk);
        auto* iat=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->FirstThunk);
        if(!desc->OriginalFirstThunk)die("missing-original-thunks");
        for(;names->u1.AddressOfData;++names,++iat){
            if(IMAGE_SNAP_BY_ORDINAL32(names->u1.Ordinal))continue;
            auto* item=reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base+names->u1.AddressOfData);
            for(U i=0;i<6;++i)if(same(reinterpret_cast<const char*>(item->Name),import_names[i])){
                DWORD old=0;
                if(!VirtualProtect(&iat->u1.Function,sizeof(U),PAGE_READWRITE,&old))die("protect",i);
                import_cells[i]=&iat->u1.Function;
                original_endpoints[i]=iat->u1.Function;
                iat->u1.Function=endpoints[i];
                DWORD ignored=0;VirtualProtect(&iat->u1.Function,sizeof(U),old,&ignored);
                seen[i]=true;
            }
        }
    }
    for(U i=0;i<6;++i)if(!seen[i])die("missing-import",i);
}
static void restore_imports(){
    for(U i=0;i<6;++i){DWORD old=0,ignored=0;
        if(!VirtualProtect(import_cells[i],sizeof(U),PAGE_READWRITE,&old))die("restore-protect",i);
        *import_cells[i]=original_endpoints[i];
        if(!VirtualProtect(import_cells[i],sizeof(U),old,&ignored))die("restore-mode",i);
    }
}
static void install(){
    pin_imports();
    endpoints[0]=word(reinterpret_cast<const void*>(&stub_load));
    endpoints[1]=word(reinterpret_cast<const void*>(&stub_proc));
    endpoints[2]=word(reinterpret_cast<const void*>(&stub_free));
    endpoints[3]=word(reinterpret_cast<const void*>(&stub_module));
    endpoints[4]=word(reinterpret_cast<const void*>(&stub_disable));
    endpoints[5]=word(reinterpret_cast<const void*>(&stub_error));
    for(U i=0;i<2;++i){
        if(original_load[i][0]!=0x8b||original_load[i][1]!=0x35)die("mov-esi",i);
        U operand;std::memcpy(&operand,original_load[i]+2,4);
        if(operand!=original_iat[i]||original_call[i][0]!=0xff||original_call[i][1]!=0xd6)
            die("esi-call",i);
    }
    code=static_cast<unsigned char*>(VirtualAlloc(nullptr,0x1000,MEM_COMMIT|MEM_RESERVE,PAGE_EXECUTE_READWRITE));
    if(!code)die("alloc");
    for(U i=0;i<6;++i){
        block[i]=code+i*0x40;U p=0;
        if(i<2){block[i][p++]=0x56; // synthetic save of caller ESI
            std::memcpy(block[i]+p,original_load[i],6);
            U target=word(&endpoints[i]);std::memcpy(block[i]+p+2,&target,4);p+=6;
        }
        // Synthetic pushes from cdecl wrapper arguments; DLL endpoint uses stdcall cleanup.
        for(U n=0;n<arg_count[i];++n){block[i][p++]=0xff;block[i][p++]=0x74;
            block[i][p++]=0x24;block[i][p++]=static_cast<unsigned char>((arg_count[i]+(i<2))*4);}
        if(i>=2){
            if(original_call[i][0]!=0xff||original_call[i][1]!=0x15)die("call-opcode",i);
            U operand;std::memcpy(&operand,original_call[i]+2,4);
            if(operand!=original_iat[i])die("call-iat",i);
        }
        std::memcpy(block[i]+p,original_call[i],call_length[i]);
        if(i>=2){U target=word(&endpoints[i]);std::memcpy(block[i]+p+2,&target,4);}
        p+=call_length[i];
        if(i<2)block[i][p++]=0x5e; // synthetic restore of caller ESI
        block[i][p++]=0xc3; // cdecl render_win boundary
    }
    FlushInstructionCache(GetCurrentProcess(),code,0x1000);
    patch_imports();
}
struct Capture{U esp0,esp1,ebp0,ebp1,ebx0,ebx1,esi0,esi1,edi0,edi1,eax;};
static Capture invoke(const void* fn,U argc,U a,U b){
    Capture r{};
    __asm {
        mov ebx,13579bdfh
        mov esi,2468ace0h
        mov edi,6a31c5e7h
        lea edx,r
        mov [edx],esp
        mov [edx+8],ebp
        mov [edx+16],ebx
        mov [edx+24],esi
        mov [edx+32],edi
        cmp argc,2
        jb one
        push b
    one:
        cmp argc,1
        jb callit
        push a
    callit:
        mov ecx,fn
        call ecx
        lea edx,r
        mov [edx+40],eax
        mov ecx,argc
        shl ecx,2
        add esp,ecx
        lea edx,r
        mov [edx+4],esp
        mov [edx+12],ebp
        mov [edx+20],ebx
        mov [edx+28],esi
        mov [edx+36],edi
    }
    return r;
}
static bool abi(const Capture& r){return r.esp0==r.esp1&&r.ebp0==r.ebp1&&r.ebx0==r.ebx1&&
    r.esi0==r.esi1&&r.edi0==r.edi1&&r.ebx0==0x13579bdfu&&r.esi0==0x2468ace0u&&r.edi0==0x6a31c5e7u;}
struct State{U count;Event log[16];};
static void reset(){event_count=0;std::memset(events,0,sizeof(events));last_error_value=0x1728394au;}
static State state(){State s{};s.count=event_count;std::memcpy(s.log,events,sizeof(events));return s;}
static const void* native[6]={
    reinterpret_cast<const void*>(&porsche::render_win_load_library_005b2050),
    reinterpret_cast<const void*>(&porsche::render_win_get_proc_005b205c),
    reinterpret_cast<const void*>(&porsche::render_win_free_library_005b2088),
    reinterpret_cast<const void*>(&porsche::render_win_get_module_005b2138),
    reinterpret_cast<const void*>(&porsche::render_win_disable_thread_calls_005b21b4),
    reinterpret_cast<const void*>(&porsche::render_win_last_error_005b213c)};
static bool compare(U i,U a,U b=0){
    reset();Capture x=invoke(block[i],arg_count[i],a,b);State expected=state();
    reset();Capture y=invoke(native[i],arg_count[i],a,b);State actual=state();++cases;
    bool result=(i==0||i==1||i==3||i==5);
    if(!abi(x)||!abi(y)||std::memcmp(&expected,&actual,sizeof(State))||(result&&x.eax!=y.eax)){
        std::printf("divergence render-win-%u case=%u abi=%u/%u events=%u/%u eax=%08x/%08x\n",
            i,cases,abi(x),abi(y),expected.count,actual.count,x.eax,y.eax);return false;}
    return true;
}
static bool failure_sequence(){
    auto run=[&](bool orig){reset();
        Capture a=invoke(orig?block[0]:native[0],1,0,0);
        Capture b=invoke(orig?block[5]:native[5],0,0,0);
        if(!abi(a)||!abi(b))die("sequence-abi");
        struct Result{State state;U error;};return Result{state(),b.eax};
    };
    auto x=run(true),y=run(false);++cases;
    if(std::memcmp(&x,&y,sizeof x)){std::printf("divergence render-win-failure-order case=%u\n",cases);return false;}
    return true;
}
int main(){
    install();bool ok=true;
    static const char dll[]="THRASH.DLL",symbol[]="_THRASH_about@0";
    ok&=compare(0,word(dll));ok&=compare(0,0);
    ok&=compare(1,0x23456789u,word(symbol));
    ok&=compare(2,0x23456789u);ok&=compare(3,word(dll));
    ok&=compare(4,0x456789abu);ok&=compare(5,0);
    ok&=failure_sequence();
    restore_imports();
    std::printf("render_platform_bindings_original_iat_vs_cpp=%s cases=%u\n",ok?"PASS":"FAIL",cases);
    return ok?0:1;
}
